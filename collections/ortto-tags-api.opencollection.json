{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ortto Accounts Tags API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a list of tags",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ap3api.com/v1/tags/get",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves the tags configured on the account. An empty body returns all tags; an optional search term filters the result."
        }
      ]
    }
  ],
  "bundled": true
}